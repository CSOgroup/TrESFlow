/* Test-only execution profiles for the portable QC process family. */

process {
    executor = 'local'
    shell = ['/bin/bash', '-euo', 'pipefail']
    cpus = 2
    memory = '4 GB'
    time = '30m'

    withName: FASTQC {
        publishDir = [
            path: { "${java.lang.System.getProperty('tresflow.resolvedOutdir')}/TrES_Stats/qc/fastqc" },
            mode: 'copy',
            overwrite: true
        ]
    }

    withName: MULTIQC {
        publishDir = [
            path: { "${java.lang.System.getProperty('tresflow.resolvedOutdir')}/TrES_Stats/qc/multiqc" },
            mode: 'copy',
            overwrite: true
        ]
        ext.prefix = 'multiqc_report'
    }
}

params.publish_dir_mode = 'copy'
cleanup = false

trace {
    enabled = true
    fields = 'task_id,name,status,exit,workdir,container'
}

profiles {
    phase6_qc_docker {
        docker.enabled = true
        docker.runOptions = '--network none'
        conda.enabled = false
        apptainer.enabled = false
        singularity.enabled = false
    }

    phase6_qc_conda {
        docker.enabled = false
        conda.enabled = true
        conda.useMicromamba = true
        conda.cacheDir = System.getenv('NXF_CONDA_CACHEDIR') ?: "${launchDir}/.conda"
        apptainer.enabled = false
        singularity.enabled = false
    }

    phase6_qc_apptainer_static {
        docker.enabled = false
        conda.enabled = false
        apptainer.enabled = true
        apptainer.autoMounts = true
        singularity.enabled = false
    }
}
