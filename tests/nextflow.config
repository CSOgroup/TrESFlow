/*
========================================================================================
    Nextflow config file for running nf-test tests
========================================================================================
*/

// nf-test launches the pipeline from an isolated directory and supplies this
// file explicitly, so load the repository profiles and process configuration.
includeConfig '../nextflow.config'

params {
    modules_testdata_base_path = 'https://raw.githubusercontent.com/nf-core/test-datasets/modules/data/'
    pipelines_testdata_base_path = 'https://raw.githubusercontent.com/nf-core/test-datasets/refs/heads/tres'
}

aws.client.anonymous = true
