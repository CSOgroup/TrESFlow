/*
 * Test-only execution profiles for the isolated Phase 1 helper workflow.
 * They are intentionally not production pipeline profiles: other TrESFlow
 * process families do not yet have complete portable dependency declarations.
 */

profiles {
    phase1_helpers_docker {
        docker.enabled = true
        conda.enabled = false
        apptainer.enabled = false
        singularity.enabled = false
    }

    phase1_helpers_conda {
        docker.enabled = false
        conda.enabled = true
        conda.useMicromamba = true
        conda.cacheDir = System.getenv('NXF_CONDA_CACHEDIR') ?: "${launchDir}/.conda"
        apptainer.enabled = false
        singularity.enabled = false
    }

    phase1_helpers_apptainer {
        docker.enabled = false
        conda.enabled = false
        apptainer.enabled = true
        apptainer.autoMounts = true
        singularity.enabled = false
    }
}
