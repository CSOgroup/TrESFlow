/* Test-only execution profiles for the portable DNA processing family. */

process {
    executor = 'local'
    shell = ['/bin/bash', '-euo', 'pipefail']
    cpus = 2
    memory = '4 GB'
    time = '30m'

    withName: GATK4_MARKDUPLICATES {
        ext.prefix = { "${meta.id}_MarkedDup.bam" }
        ext.args = {
            "--REMOVE_DUPLICATES false --BARCODE_TAG CB " +
            "--READ_NAME_REGEX '^(?:[^:]+:){4}([0-9]+):([0-9]+):([0-9]+):[^:]+\$' " +
            "--OPTICAL_DUPLICATE_PIXEL_DISTANCE 10 " +
            "--CREATE_INDEX true --MAX_RECORDS_IN_RAM 10000000"
        }
    }

    withName: DEEPTOOLS_BAMCOVERAGE {
        publishDir = [
            path: { "${java.lang.System.getProperty('tresflow.resolvedOutdir')}/dna_align" },
            mode: 'copy',
            overwrite: true,
            pattern: '*_NoDup.bw'
        ]
        ext.prefix = { "${meta.id}_NoDup" }
        ext.args = { "-bs 100 --extendReads --centerReads --effectiveGenomeSize ${meta.dna_effective_genome_size}" }
    }
}

params.publish_dir_mode = 'copy'
cleanup = false

trace {
    enabled = true
    fields = 'task_id,name,status,exit,workdir,container'
}

profiles {
    phase5_dna_docker {
        docker.enabled = true
        docker.runOptions = '--network none'
        conda.enabled = false
        apptainer.enabled = false
        singularity.enabled = false
    }

    phase5_dna_conda {
        docker.enabled = false
        conda.enabled = true
        conda.useMicromamba = true
        conda.cacheDir = System.getenv('NXF_CONDA_CACHEDIR') ?: "${launchDir}/.conda"
        apptainer.enabled = false
        singularity.enabled = false
    }

    phase5_dna_apptainer_static {
        docker.enabled = false
        conda.enabled = false
        apptainer.enabled = true
        apptainer.autoMounts = true
        singularity.enabled = false
    }
}
