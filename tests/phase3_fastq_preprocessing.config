/* Test-only execution profiles for the isolated FASTQ preprocessing family. */

process {
    executor = 'local'
    shell = ['/bin/bash', '-euo', 'pipefail']
    cpus = 1
    memory = '1 GB'
    time = '30m'
}

trace {
    enabled = true
    fields = 'task_id,name,status,exit,workdir,container'
}

profiles {
    phase3_fastq_docker {
        docker.enabled = true
        docker.runOptions = '--network none'
        conda.enabled = false
        apptainer.enabled = false
        singularity.enabled = false
    }

    phase3_fastq_conda {
        docker.enabled = false
        conda.enabled = true
        conda.useMicromamba = true
        conda.cacheDir = System.getenv('NXF_CONDA_CACHEDIR') ?: "${launchDir}/.conda"
        apptainer.enabled = false
        singularity.enabled = false
    }

    phase3_fastq_apptainer_static {
        docker.enabled = false
        conda.enabled = false
        apptainer.enabled = true
        apptainer.autoMounts = true
        singularity.enabled = false
    }
}
