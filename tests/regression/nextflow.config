// Test-only resource caps for the deterministic miniature reference.
// No process is mocked, skipped, or otherwise behaviorally altered here.
params {
    max_cpus = 2
    cleanup_work = false
    tagging_cpus = 1
    tagging_memory = '2 GB'
    trim_cpus = 1
    trim_memory = '1 GB'
    artifact_filter_cpus = 1
    artifact_filter_memory = '1 GB'
    rna_starsolo_cpus = 2
    rna_starsolo_memory = '4 GB'
    rna_coverage_cpus = 1
    rna_coverage_memory = '2 GB'
    dna_align_cpus = 2
    dna_align_memory = '2 GB'
    dna_markdup_memory = '2 GB'
    dna_coverage_cpus = 1
    dna_coverage_memory = '1 GB'
}

process {
    withName: FASTQC {
        cpus = 1
        memory = '1 GB'
    }
    withName: MULTIQC {
        cpus = 1
        memory = '1 GB'
    }
    withName: GATK4_MARKDUPLICATES {
        cpus = 1
        memory = '2 GB'
    }
    withName: DEEPTOOLS_BAMCOVERAGE {
        cpus = 1
        memory = '1 GB'
    }
}
