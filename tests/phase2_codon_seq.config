/*
 * Test-only profiles for the isolated Codon/Seq family. The local image is
 * built from containers/codon-seq/Dockerfile and is deliberately unpublished.
 */

profiles {
    phase2_codon_seq_docker {
        docker.enabled = true
        docker.runOptions = '--network none'
        conda.enabled = false
        apptainer.enabled = false
        singularity.enabled = false

        process {
            withLabel: codon_wrapper {
                container = 'tresflow-codon-seq:phase2-local'
                ext.mock = false
            }
        }
    }

    phase2_codon_seq_conda {
        docker.enabled = false
        conda.enabled = true
        conda.useMicromamba = true
        conda.cacheDir = System.getenv('NXF_CONDA_CACHEDIR') ?: "${launchDir}/.conda"
        apptainer.enabled = false
        singularity.enabled = false

        process {
            withLabel: codon_wrapper {
                ext.mock = false
            }
        }
    }
}
