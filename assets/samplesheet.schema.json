{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "title": "TrESFlow hierarchical YAML samplesheet",
    "description": "Normal selectors first; sb_oligo_pairings is an exceptional declaration for experimenter mismatches. The runtime parser checks physical lookup availability, normalized uniqueness and routing.",
    "type": "object",
    "required": ["library_name", "runtime", "references", "samples"],
    "properties": {
        "library_name": {
            "type": "string",
            "minLength": 1
        },
        "runtime": {
            "type": "object"
        },
        "references": {
            "type": "object",
            "description": "Raw-start runs require the ligation whitelist. Full and restart runs require root, species, and genome references for the active modalities. The CLI selects the mode, and the runtime parser enforces its requirements.",
            "properties": {
                "ligation_barcode_whitelist": {
                    "type": "string",
                    "minLength": 1
                },
                "root": {
                    "type": "string",
                    "minLength": 1
                },
                "species": {
                    "type": "string",
                    "minLength": 1
                },
                "rna_ref_dir": {
                    "type": "string",
                    "minLength": 1
                },
                "dna_ref_dir": {
                    "type": "string",
                    "minLength": 1
                },
                "dna_blacklist_bed": {
                    "type": "string",
                    "minLength": 1
                },
                "dna_chrom_sizes": {
                    "type": "string",
                    "minLength": 1
                },
                "dna_effective_genome_size": {
                    "oneOf": [
                        {
                            "type": "integer",
                            "minimum": 1
                        },
                        {
                            "type": "string",
                            "pattern": "^[1-9][0-9]*$"
                        }
                    ]
                }
            }
        },
        "samples": {
            "type": "object",
            "minProperties": 1,
            "additionalProperties": {
                "type": "object",
                "properties": {
                    "preprocessed": {
                        "description": "One FASTQ pair per RNA group or DNA group and mark. Used with --preprocessed_input true. Relative FASTQ paths resolve from the samplesheet directory.",
                        "type": "array",
                        "minItems": 1,
                        "items": { "$ref": "#/$defs/preprocessed_pair" }
                    },
                    "groups": {
                        "type": "object",
                        "minProperties": 1,
                        "additionalProperties": {
                            "$ref": "#/$defs/group"
                        }
                    },
                    "rna": {
                        "type": "object",
                        "description": "The reads mapping is required on a raw start and optional on restart."
                    },
                    "dna": {
                        "type": "object",
                        "description": "The reads mapping is required on a raw start and optional on restart.",
                        "required": ["tagmentation"],
                        "properties": {
                            "tagmentation": {
                                "$ref": "#/$defs/dna_tagmentation"
                            }
                        }
                    }
                },
                "allOf": [
                    {
                        "if": { "not": { "required": ["preprocessed"] } },
                        "then": {
                            "required": ["groups"],
                            "anyOf": [
                                { "required": ["rna"] },
                                { "required": ["dna"] }
                            ]
                        }
                    },
                    {
                        "if": {
                            "required": ["dna"],
                            "properties": {
                                "dna": {
                                    "required": ["tagmentation"],
                                    "properties": {
                                        "tagmentation": {
                                            "$ref": "#/$defs/single_tagmentation"
                                        }
                                    }
                                }
                            }
                        },
                        "then": {
                            "properties": {
                                "groups": {
                                    "additionalProperties": {
                                        "not": {
                                            "required": ["dna_sb_oligo_indices", "sb_barcodes"]
                                        }
                                    }
                                }
                            }
                        }
                    }
                ]
            }
        }
    },
    "$defs": {
        "preprocessed_pair": {
            "type": "object",
            "required": ["group", "modality", "r1", "r2"],
            "properties": {
                "group": { "type": "string", "pattern": "^[A-Za-z0-9_.-]+$" },
                "modality": { "enum": ["rna", "dna"] },
                "mark": { "type": "string", "pattern": "^[A-Za-z0-9_.-]+$" },
                "mark_barcode": {
                    "type": "string",
                    "minLength": 1,
                    "description": "Optional expected MO tag on a DNA split."
                },
                "r1": { "$ref": "#/$defs/preprocessed_fastq_path" },
                "r2": { "$ref": "#/$defs/preprocessed_fastq_path" }
            },
            "if": { "properties": { "modality": { "const": "dna" } } },
            "then": { "required": ["mark"] },
            "else": {
                "not": { "anyOf": [{ "required": ["mark"] }, { "required": ["mark_barcode"] }] }
            }
        },
        "preprocessed_fastq_path": {
            "type": "string",
            "pattern": ".+\\.(fastq|fq)(\\.gz)?$"
        },
        "index": {
            "oneOf": [
                {
                    "type": "integer",
                    "minimum": 1
                },
                {
                    "type": "string",
                    "pattern": "^[0-9]*[1-9][0-9]*$"
                }
            ]
        },
        "index_list": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
                "$ref": "#/$defs/index"
            }
        },
        "sequence_list": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
                "type": "string",
                "pattern": "^[\\u0000-\\u0020]*[ACGT]{3,4}[\\u0000-\\u0020]*$"
            }
        },
        "pairing": {
            "type": "object",
            "additionalProperties": false,
            "required": ["sb_index"],
            "properties": {
                "sb_index": {
                    "$ref": "#/$defs/index"
                },
                "rna_oligo_index": {
                    "$ref": "#/$defs/index"
                },
                "dna_oligo_index": {
                    "$ref": "#/$defs/index"
                },
                "rna_sb_barcode": {
                    "type": "string",
                    "pattern": "^[\\u0000-\\u0020]*[ACGT]{4}[\\u0000-\\u0020]*$"
                },
                "dna_sb_barcode": {
                    "type": "string",
                    "pattern": "^[\\u0000-\\u0020]*[ACGT]{3,4}[\\u0000-\\u0020]*$"
                }
            },
            "anyOf": [
                {
                    "required": ["rna_oligo_index"]
                },
                {
                    "required": ["dna_oligo_index"]
                },
                {
                    "required": ["rna_sb_barcode"]
                },
                {
                    "required": ["dna_sb_barcode"]
                }
            ],
            "allOf": [
                {
                    "not": {
                        "required": ["rna_oligo_index", "rna_sb_barcode"]
                    }
                },
                {
                    "not": {
                        "required": ["dna_oligo_index", "dna_sb_barcode"]
                    }
                }
            ]
        },
        "group": {
            "type": "object",
            "properties": {
                "sb_oligo_indices": {
                    "$ref": "#/$defs/index_list"
                },
                "rna_sb_oligo_indices": {
                    "$ref": "#/$defs/index_list"
                },
                "dna_sb_oligo_indices": {
                    "$ref": "#/$defs/index_list"
                },
                "sb_barcodes": {
                    "$ref": "#/$defs/sequence_list"
                },
                "rna_sb_barcodes": {
                    "$ref": "#/$defs/sequence_list"
                },
                "dna_sb_barcodes": {
                    "$ref": "#/$defs/sequence_list"
                },
                "sb_oligo_pairings": {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                        "$ref": "#/$defs/pairing"
                    }
                },
                "mark_barcodes": {
                    "type": "object",
                    "minProperties": 1,
                    "additionalProperties": {
                        "type": "string",
                        "minLength": 1
                    }
                }
            },
            "allOf": [
                {
                    "not": {
                        "required": ["sb_oligo_pairings", "sb_oligo_indices"]
                    }
                },
                {
                    "not": {
                        "required": ["sb_oligo_pairings", "rna_sb_oligo_indices"]
                    }
                },
                {
                    "not": {
                        "required": ["sb_oligo_pairings", "dna_sb_oligo_indices"]
                    }
                },
                {
                    "not": {
                        "required": ["sb_oligo_pairings", "sb_barcodes"]
                    }
                },
                {
                    "not": {
                        "required": ["sb_oligo_pairings", "rna_sb_barcodes"]
                    }
                },
                {
                    "not": {
                        "required": ["sb_oligo_pairings", "dna_sb_barcodes"]
                    }
                },
                {
                    "not": {
                        "required": ["sb_oligo_indices", "rna_sb_oligo_indices"]
                    }
                },
                {
                    "not": {
                        "required": ["sb_oligo_indices", "dna_sb_oligo_indices"]
                    }
                },
                {
                    "not": {
                        "required": ["sb_oligo_indices", "sb_barcodes"]
                    }
                },
                {
                    "not": {
                        "required": ["sb_oligo_indices", "rna_sb_barcodes"]
                    }
                },
                {
                    "not": {
                        "required": ["sb_oligo_indices", "dna_sb_barcodes"]
                    }
                },
                {
                    "not": {
                        "required": ["rna_sb_oligo_indices", "rna_sb_barcodes"]
                    }
                },
                {
                    "not": {
                        "required": ["rna_sb_oligo_indices", "sb_barcodes"]
                    }
                },
                {
                    "not": {
                        "required": ["dna_sb_oligo_indices", "dna_sb_barcodes"]
                    }
                }
            ],
            "anyOf": [
                {
                    "required": ["sb_oligo_indices"]
                },
                {
                    "required": ["rna_sb_oligo_indices"]
                },
                {
                    "required": ["dna_sb_oligo_indices"]
                },
                {
                    "required": ["sb_barcodes"]
                },
                {
                    "required": ["rna_sb_barcodes"]
                },
                {
                    "required": ["dna_sb_barcodes"]
                },
                {
                    "required": ["sb_oligo_pairings"]
                }
            ]
        },
        "single_tagmentation": {
            "type": "string",
            "pattern": "^[\\u0000-\\u0020]*[sS][iI][nN][gG][lL][eE][\\u0000-\\u0020]*$"
        },
        "dual_tagmentation": {
            "type": "string",
            "pattern": "^[\\u0000-\\u0020]*[dD][uU][aA][lL][\\u0000-\\u0020]*$"
        },
        "dna_tagmentation": {
            "description": "Chemistry names are trimmed and case-insensitive, as in the runtime parser.",
            "anyOf": [
                {
                    "$ref": "#/$defs/single_tagmentation"
                },
                {
                    "$ref": "#/$defs/dual_tagmentation"
                }
            ]
        }
    }
}
