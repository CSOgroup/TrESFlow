/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Config file for defining optional DSL2 per-module overrides
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    TrESFlow handles publish locations explicitly inside the local modules that need
    published outputs. This file is kept as an nf-core-compatible placeholder and
    must not define a global `publishDir` without a target path.
----------------------------------------------------------------------------------------
*/

process {
    withName: FASTQC {
        publishDir = [
            path     : { "${java.lang.System.getProperty('tresflow.resolvedOutdir')}/TrES_Stats/qc/fastqc" },
            mode     : params.publish_dir_mode,
            overwrite: true
        ]
    }

    withName: GATK4_MARKDUPLICATES {
        ext.prefix = { "${meta.id}_MarkedDup.bam" }
        ext.args = {
            "--REMOVE_DUPLICATES false --BARCODE_TAG CB " +
            "--READ_NAME_REGEX '^(?:[^:]+:){4}([0-9]+):([0-9]+):([0-9]+):[^:]+\$' " +
            "--OPTICAL_DUPLICATE_PIXEL_DISTANCE ${params.aviti_optical_duplicate_distance} " +
            "--CREATE_INDEX true --MAX_RECORDS_IN_RAM 10000000"
        }
    }

    withName: DEEPTOOLS_BAMCOVERAGE {
        publishDir = [
            path     : { "${java.lang.System.getProperty('tresflow.resolvedOutdir')}/dna_align" },
            mode     : params.publish_dir_mode,
            overwrite: true,
            pattern  : "*_NoDup.bw"
        ]
        ext.prefix = { "${meta.id}_NoDup" }
        ext.args = { "-bs 100 --extendReads --centerReads --effectiveGenomeSize ${meta.dna_effective_genome_size}" }
    }

    withName: MULTIQC {
        publishDir = [
            path     : { "${java.lang.System.getProperty('tresflow.resolvedOutdir')}/TrES_Stats/qc/multiqc" },
            mode     : params.publish_dir_mode,
            overwrite: true
        ]
        ext.prefix = 'multiqc_report'
    }
}
