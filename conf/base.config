process {
    executor = 'local'
    shell    = ['/bin/bash', '-euo', 'pipefail']
    cpus     = 1
    memory   = '1 GB'
    time     = '12h'

    // Truly lightweight/single-threaded helpers. Process-specific overrides
    // below replace this where tools genuinely scale with additional resources.
    withLabel: process_single {
        cpus = 1
        memory = '4 GB'
        time = '12h'
    }

    // -----------------------------------------------------------------------
    // Barcode / UMI / cell-barcode tagging
    // -----------------------------------------------------------------------

    withName: TAG_RNA_SAMPLE_BARCODE {
        cpus = Math.max(1, Math.min((params.tagging_cpus ?: 4) as int, params.max_cpus as int))
        memory = params.tagging_memory ?: '32 GB'
        time = '24h'
    }

    withName: TAG_DNA_SAMPLE_BARCODE {
        cpus = Math.max(1, Math.min((params.tagging_cpus ?: 4) as int, params.max_cpus as int))
        memory = params.tagging_memory ?: '32 GB'
        time = '24h'
    }

    withName: TAG_RNA_UMI {
        cpus = Math.max(1, Math.min((params.tagging_cpus ?: 4) as int, params.max_cpus as int))
        memory = params.tagging_memory ?: '32 GB'
        time = '24h'
    }

    withName: TAG_DNA_MODALITY_BARCODE {
        cpus = Math.max(1, Math.min((params.tagging_cpus ?: 4) as int, params.max_cpus as int))
        memory = params.tagging_memory ?: '32 GB'
        time = '24h'
    }

    withName: TAG_RNA_CELL_BARCODE {
        cpus = Math.max(1, Math.min((params.tagging_cpus ?: 4) as int, params.max_cpus as int))
        memory = params.tagging_memory ?: '32 GB'
        time = '24h'
    }

    withName: TAG_DNA_CELL_BARCODE {
        cpus = Math.max(1, Math.min((params.tagging_cpus ?: 4) as int, params.max_cpus as int))
        memory = params.tagging_memory ?: '32 GB'
        time = '24h'
    }

    // -----------------------------------------------------------------------
    // FASTQ processing
    // -----------------------------------------------------------------------

    withName: TRIM_RNA_FASTQS {
        cpus = Math.max(1, Math.min((params.trim_cpus ?: 6) as int, params.max_cpus as int))
        memory = params.trim_memory ?: '4 GB'
        time = '12h'
    }

    withName: TRIM_DNA_FASTQS {
        cpus = Math.max(1, Math.min((params.trim_cpus ?: 6) as int, params.max_cpus as int))
        memory = params.trim_memory ?: '4 GB'
        time = '12h'
    }

    withName: DUAL_TAG_ARTIFACT_FILTER {
        cpus = Math.max(1, Math.min((params.artifact_filter_cpus ?: 8) as int, params.max_cpus as int))
        memory = params.artifact_filter_memory ?: '8 GB'
        time = '12h'
    }

    // Split_ReadsV2 is not currently threaded by task.cpus. Reserve one CPU
    // rather than blocking several scheduler slots that the process cannot use.
    withName: SPLIT_RNA_READS {
        cpus = 2
        memory = '2 GB'
        time = '12h'
    }

    withName: SPLIT_DNA_READS {
        cpus = 3
        memory = '2 GB'
        time = '12h'
    }

    // Optional publication compression uses pigz -p task.cpus.
    withName: /COMPRESS_.*_SPLIT_FASTQS/ {
        cpus = Math.max(1, Math.min(8, params.max_cpus as int))
        memory = '4 GB'
        time = '12h'
    }

    withName: FQ_TO_SAM {
        cpus = 2
        memory = '1 GB'
        time = '12h'
    }

    // -----------------------------------------------------------------------
    // RNA
    // -----------------------------------------------------------------------

    withName: RNA_STARSOLO_ALIGN {
        cpus = Math.max(1, Math.min((params.rna_starsolo_cpus ?: 24) as int, params.max_cpus as int))
        memory = params.rna_starsolo_memory ?: '40 GB'
        time = '48h'
    }

    // The final samtools filter is threaded, but its retention audit contains
    // sequential work, so a moderate allocation is preferable.
    withName: RNA_FILTERED_BAM {
        cpus = 2
        memory = '2 GB'
        time = '24h'
    }

    // RNA coverage invokes STAR twice; later bedGraph sorting/conversion is
    // serial, so use a moderate CPU allocation but STAR-sized memory.
    withName: RNA_COVERAGE {
        cpus = Math.max(1, Math.min((params.rna_coverage_cpus ?: 4) as int, params.max_cpus as int))
        memory = params.rna_coverage_memory ?: '24 GB'
        time = '24h'
    }

    // -----------------------------------------------------------------------
    // General QC
    // -----------------------------------------------------------------------

    withName: FASTQC {
        cpus = Math.max(1, Math.min(4, params.max_cpus as int))
        memory = '4 GB'
        time = '12h'
    }

    // flagstat/stats/idxstats run sequentially per BAM. Two threads are enough
    // for BGZF assistance while allowing many BAM-QC tasks to overlap.
    withName: SAMTOOLS_BAM_QC {
        cpus = 2
        memory = '1 GB'
        time = '12h'
    }

    // -----------------------------------------------------------------------
    // DNA
    // -----------------------------------------------------------------------

    // ALIGN_DNA passes task.cpus to bwa-mem2 and samtools. Keeping 16 CPUs
    // allows several independent group/mark alignments to execute concurrently.
    withName: ALIGN_DNA {
        cpus = Math.max(1, Math.min((params.dna_align_cpus ?: 16) as int, params.max_cpus as int))
        memory = params.dna_align_memory ?: '24 GB'
        time = '48h'
    }

    withName: FILTER_CANONICAL_DNA_ALIGNED_BAM {
        cpus = 3
        memory = '1 GB'
        time = '24h'
    }

    withName: GATK4_MARKDUPLICATES {
        cpus = 4
        memory = params.dna_markdup_memory ?: '16 GB'
        time = '48h'
    }

    withName: NORMALIZE_DNA_MARKDUPLICATES {
        cpus = 3
        memory = '1 GB'
        time = '24h'
    }

    withName: SPLIT_DUPLICATES_DNA {
        cpus = 4
        memory = '1 GB'
        time = '24h'
    }

    withName: DEEPTOOLS_BAMCOVERAGE {
        cpus = Math.max(1, Math.min((params.dna_coverage_cpus ?: 8) as int, params.max_cpus as int))
        memory = params.dna_coverage_memory ?: '8 GB'
        time = '24h'
    }
    withName: BARCODE_GATE_METRICS {
        cpus = 1
        memory = '1 GB'
        time = '12h'
    }

    withName: MULTIQC {
        cpus = 1
        memory = '3 GB'
        time = '12h'
    }

    withName: TRES_REPORT_HTML {
        cpus = 1
        memory = '1 GB'
        time = '12h'
    }

}

timeline {
    enabled   = true
    file      = "${params.outdir ?: "${launchDir}/results"}/pipeline_info/execution_timeline.html"
    overwrite = true
}

report {
    enabled   = true
    file      = "${params.outdir ?: "${launchDir}/results"}/pipeline_info/execution_report.html"
    overwrite = true
}

trace {
    enabled   = true
    file      = "${params.outdir ?: "${launchDir}/results"}/pipeline_info/execution_trace.tsv"
    overwrite = true
}

dag {
    enabled   = true
    file      = "${params.outdir ?: "${launchDir}/results"}/pipeline_info/flowchart.html"
    overwrite = true
}
